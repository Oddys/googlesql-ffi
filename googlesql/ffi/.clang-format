BasedOnStyle: Google
ColumnLimit: 100
# One parameter per line in declarations/definitions.
BinPackParameters: OnePerLine
# Same thing for arguments at call sites.
BinPackArguments: false
# Don't put all params together on the next line.
AllowAllParametersOfDeclarationOnNextLine: false
# Don't put all args together on the next line.
AllowAllArgumentsOnNextLine: false
# Each param/arg and the closing parenthesis on its own line.
AlignAfterOpenBracket: BlockIndent
# If body always on its own line.
AllowShortIfStatementsOnASingleLine: Never
# While/for body always on its own line.
AllowShortLoopsOnASingleLine: false
# Function body (e.g. return) always on its own line.
AllowShortFunctionsOnASingleLine: None
# Same for lambdas.
AllowShortLambdasOnASingleLine: None
# Code in nested namespaces is indented (allows to fold a namespace block in the editor)
NamespaceIndentation: Inner
